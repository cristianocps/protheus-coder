# Copy to .env and fill in. Never commit the real .env.

# Anthropic API key used by the Claude Agent SDK (ask_codebase).
ANTHROPIC_API_KEY=sk-ant-...

# Optional: pin a cheaper/faster Claude model for ask_codebase (SDK default if
# left empty), e.g. a Haiku-class model id.
CLAUDE_MODEL=

# Static API key that Copilot Studio's custom connector sends as X-API-Key.
# Generate a long random value, e.g.: openssl rand -hex 32
MCP_API_KEY=

# Azure DevOps organization slug (the part after dev.azure.com/).
AZDO_ORG=contoso

# Azure DevOps Personal Access Token, read-only, scope: Code (Read).
# This is the "chave privada" mounted into the container to clone repos.
AZDO_PAT=
